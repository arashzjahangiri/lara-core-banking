# Build and run the risk service.
#
# Multi-stage so the runtime image carries no Maven, no sources and no build cache. Built from the
# repository root, because the bootstrap module needs its sibling modules to compile:
#
#   docker build -f services/risk/bootstrap/src/main/docker/Dockerfile.jvm -t lara/risk .
#
# The build stage uses the official Maven image rather than the wrapper. The wrapper is right for
# humans and for CI — it pins the version with a checksum and needs no local install — but its
# bootstrap download is a network call that can truncate, and inside a container that failure
# surfaces as "Failed to validate Maven distribution SHA-256" with no useful context.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# Every service's pom, not just this one's. The root pom aggregates all four, so Maven refuses to
# read it while any child is missing — copying only this service's descriptors fails with
# "Child module ... does not exist" before a single dependency is resolved.
#
# Descriptors first, sources after, so dependency resolution caches independently of source
# changes. Editing a Java file then costs a recompile, not a re-download.
COPY pom.xml .
COPY services/ledger/pom.xml                services/ledger/
COPY services/ledger/domain/pom.xml         services/ledger/domain/
COPY services/ledger/application/pom.xml    services/ledger/application/
COPY services/ledger/infrastructure/pom.xml services/ledger/infrastructure/
COPY services/ledger/bootstrap/pom.xml      services/ledger/bootstrap/
COPY services/accounts/pom.xml                services/accounts/
COPY services/accounts/domain/pom.xml         services/accounts/domain/
COPY services/accounts/application/pom.xml    services/accounts/application/
COPY services/accounts/infrastructure/pom.xml services/accounts/infrastructure/
COPY services/accounts/bootstrap/pom.xml      services/accounts/bootstrap/
COPY services/risk/pom.xml                services/risk/
COPY services/risk/domain/pom.xml         services/risk/domain/
COPY services/risk/application/pom.xml    services/risk/application/
COPY services/risk/infrastructure/pom.xml services/risk/infrastructure/
COPY services/risk/bootstrap/pom.xml      services/risk/bootstrap/
COPY services/payments/pom.xml                services/payments/
COPY services/payments/domain/pom.xml         services/payments/domain/
COPY services/payments/application/pom.xml    services/payments/application/
COPY services/payments/infrastructure/pom.xml services/payments/infrastructure/
COPY services/payments/bootstrap/pom.xml      services/payments/bootstrap/

# No `|| true` here. A failed dependency download must stop the build rather than leave a partial
# cache for a later step to trip over.
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B --no-transfer-progress dependency:go-offline -DskipTests

COPY services services
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B --no-transfer-progress clean package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app

# curl is here for the compose health check, nothing else.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Never run as root.
RUN useradd --system --uid 1001 --create-home risk
USER 1001

COPY --from=build --chown=1001 /build/services/risk/bootstrap/target/quarkus-app/lib/      /app/lib/
COPY --from=build --chown=1001 /build/services/risk/bootstrap/target/quarkus-app/*.jar     /app/
COPY --from=build --chown=1001 /build/services/risk/bootstrap/target/quarkus-app/app/      /app/app/
COPY --from=build --chown=1001 /build/services/risk/bootstrap/target/quarkus-app/quarkus/  /app/quarkus/

EXPOSE 8110
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/quarkus-run.jar"]